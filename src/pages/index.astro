---
import Base from '../layouts/Base.astro';
import { WAITLIST_ENDPOINT } from '../config';

const title = 'Fidius — The auto-router that learns your code';
const description =
  'Trained on your own data, in your environment, across any vendor. Up to 50% lower coding-agent spend, without accuracy loss.';

// Routing drawing, in the SVG's own units (1600 × 800 = 16em × 8em around the headline).
// The router sits on the dot of the "i" in "cutting" (measured in a browser).
const router = { x: 706, y: 439 };
const modelX = 1330;
const modelYs = [180, 290, 400, 510, 620];
const inYs = [280, 440, 520];

const incoming = (y: number) =>
  y === router.y
    ? `M-200 ${y} L${router.x} ${y}`
    : `M-200 ${y} C 300 ${y}, ${router.x - 181} ${router.y}, ${router.x} ${router.y}`;
const branch = (y: number) =>
  `M${router.x} ${router.y} C ${router.x + 209} ${router.y}, ${router.x + 304} ${y}, ${modelX} ${y}`;

// Each route: which incoming line a session arrives on, which model it is routed to, and when.
const routes = [
  { inY: 280, outY: 180, delay: 0 },
  { inY: 520, outY: 510, delay: 2.2 },
  { inY: 440, outY: 290, delay: 4.4 },
  { inY: 280, outY: 620, delay: 6.6 },
  { inY: 520, outY: 400, delay: 8.8 },
];

const agents = ['Claude Code', 'Cursor', 'OpenAI Codex', 'GitHub Copilot', 'Gemini CLI'];

const comparison = [
  {
    label: 'Models',
    them: 'A fixed menu of models the vendor picked.',
    us: 'Any model, closed or open. We choose the pool with you at onboarding.',
  },
  {
    label: 'Training',
    them: 'Trained on public benchmarks.',
    us: 'Trained on your own coding tasks.',
  },
  {
    label: 'Quality bar',
    them: 'Their definition of good enough.',
    us: 'Tested on your code, checked continuously.',
  },
  {
    label: 'Where is the data',
    them: 'A black box in their cloud.',
    us: 'Runs in your environment.',
  },
];

const steps = [
  {
    title: 'Choose your models',
    text: 'Together we pick the models Fidius can route to: closed or open, from any provider.',
  },
  {
    title: 'Define your evals',
    text: 'We set test criteria with your team that describe what good work looks like in your codebase.',
  },
  {
    title: 'Train and route',
    text: 'Fidius learns from your coding tasks and sends each session to the cheapest model that passes your evals, checked continuously.',
  },
];

const faqs = [
  {
    q: 'How much money can I save?',
    a: 'Our benchmarks show up to 50% cost savings. Your exact savings are measured on your own data during onboarding.',
  },
  {
    q: 'Does it work with any coding agent?',
    a: 'Yes. Fidius decides which model handles each session, so it works with Claude Code, Cursor, Codex, GitHub Copilot, Gemini CLI and any other agent your team uses, without changing how anyone works.',
  },
  {
    q: 'Is this an AI gateway or context shrinking tool?',
    a: 'No. A gateway forwards requests to the models you choose. Context tools shrink what you send. Fidius makes the decision itself: which model should handle each session. It runs on top of your existing gateway or Bedrock account.',
  },
  {
    q: 'How is this different from built-in auto modes or other routers?',
    a: 'Generic routers make one decision for everyone, based on public benchmarks and a model menu they chose. Fidius is trained on your coding tasks, routes across the models you pick, and sends work to a cheaper model only when your own evals show accuracy is maintained. No data leaves your environment, and we do not retain any of it.',
  },
  {
    q: 'Which models can Fidius route to?',
    a: 'Any model, closed or open-weight, from any provider. During onboarding we choose the pool with you, so your team can work with every model that is relevant to your software.',
  },
];
---

<Base title={title} description={description} path="/">
    <section id="top" class="hero">
      <div class="hero-inner">
        <div class="eyebrow hero-eyebrow">Own your intelligence</div>

        <div class="headline-wrap">
          <svg class="routes" aria-hidden="true" viewBox="0 0 1600 800">
            {inYs.map((y) => <path class="route-line" d={incoming(y)} />)}
            {modelYs.map((y) => <path class="route-line" d={`${branch(y)} L2400 ${y}`} />)}

            {routes.map((r) => <path class="route-glow" d={branch(r.outY)} style={`animation-delay:${r.delay}s`} />)}
            {routes.map((r) => (
              <path
                class="route-pulse"
                pathLength="1"
                d={`${incoming(r.inY)} ${branch(r.outY).replace(/^M\S+ \S+ /, '')}`}
                style={`animation-delay:${r.delay}s`}
              />
            ))}

            {modelYs.map((y) => <circle class="route-dot" cx={modelX} cy={y} r="2.5" />)}
            {routes.map((r) => <circle class="route-hit" cx={modelX} cy={r.outY} r="8" style={`animation-delay:${r.delay}s`} />)}
            <circle class="router-ring" cx={router.x} cy={router.y} r="12" />
            <circle class="router-core" cx={router.x} cy={router.y} r="3.5" />
          </svg>
          <h1 class="headline">The auto-router that<br />learns your code.<br />Start cutting your spend.</h1>
        </div>

        <p class="subline">Trained on your own data, in your environment, across any vendor. Up to 50% lower coding-agent spend, without accuracy loss.</p>

        <div id="waitlist" class="waitlist">
          <form class="waitlist-form" data-endpoint={WAITLIST_ENDPOINT} novalidate>
            <label for="email" class="sr-only">Work email</label>
            <input id="email" name="email" type="email" required autocomplete="email" placeholder="you@company.com" />
            <div class="honeypot" aria-hidden="true">
              <label for="website">Website</label>
              <input id="website" name="_honey" type="text" tabindex="-1" autocomplete="off" />
            </div>
            <button type="submit">Join the waitlist</button>
          </form>
          <div class="waitlist-done" role="status" hidden>
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3 3 7-7" /></svg>
            <span>You are on the list. We will be in touch.</span>
          </div>
          <p class="waitlist-note" aria-live="polite">Early access for engineering teams.</p>
        </div>
      </div>
    </section>

    <section class="agents" aria-labelledby="agents-title">
      <div class="container">
        <h2 id="agents-title" class="eyebrow" style="margin:0;font-weight:400">Plugs into the coding agent you already use</h2>
        <ul class="agent-list">
          {agents.map((name) => <li>{name}</li>)}
          <li class="more">and any other agent</li>
        </ul>
      </div>
    </section>

    <section class="demo" aria-label="Fidius demo video">
      <video
        class="demo-video"
        src="/video/fidius-demo.mp4"
        poster="/video/fidius-demo-poster.jpg"
        controls
        playsinline
        preload="metadata"
        width="1920"
        height="1080"
      ></video>
    </section>

    <section id="why" class="compare" aria-labelledby="compare-title">
      <div class="eyebrow">Why Fidius</div>
      <h2 id="compare-title">Not a generic router.</h2>
      <div class="compare-grid">
        <div class="compare-head" aria-hidden="true">
          <span></span>
          <span>Generic routers</span>
          <span>Fidius</span>
        </div>
        {comparison.map((row) => (
          <div class="compare-row">
            <div class="compare-label">{row.label}</div>
            <div class="compare-them"><span class="compare-tag">Generic routers</span>{row.them}</div>
            <div class="compare-us"><span class="compare-tag">Fidius</span>{row.us}</div>
          </div>
        ))}
      </div>
    </section>

    <section id="how" class="steps" aria-labelledby="steps-title">
      <div class="eyebrow">How it works</div>
      <h2 id="steps-title">All models, your evals.</h2>
      <ol class="step-list">
        {steps.map((step, i) => (
          <li>
            <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section id="faq" class="faq" aria-labelledby="faq-title">
      <h2 id="faq-title">Questions</h2>
      {faqs.map((item) => (
        <details>
          <summary>
            <span>{item.q}</span>
            <svg class="plus" aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="#A1A1A1" stroke-width="1.5" stroke-linecap="round"><path d="M9 3v12M3 9h12" /></svg>
          </summary>
          <p>{item.a}</p>
        </details>
      ))}
    </section>

    <section id="about" class="about" aria-labelledby="about-title">
      <h2 id="about-title">About</h2>
      <p>Agents now write much of the code. Fidius is an applied AI lab for the agentic era of software.</p>
    </section>
  <script>
    const form = document.querySelector<HTMLFormElement>('.waitlist-form')!;
    const done = document.querySelector<HTMLElement>('.waitlist-done')!;
    const note = document.querySelector<HTMLElement>('.waitlist-note')!;
    const button = form.querySelector('button')!;
    const defaultNote = note.textContent;

    const showError = (message: string) => {
      note.textContent = message;
      note.dataset.state = 'error';
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
      const trap = (form.elements.namedItem('_honey') as HTMLInputElement).value;

      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showError('Please enter a valid email address.');
        return;
      }
      note.textContent = defaultNote;
      delete note.dataset.state;

      // Bots fill the hidden field; pretend it worked and send nothing.
      if (!trap) {
        const endpoint = form.dataset.endpoint;
        if (!endpoint) {
          showError('The waitlist is not connected yet.');
          return;
        }
        button.disabled = true;
        button.textContent = 'Joining…';
        try {
          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ email, _subject: 'New Fidius waitlist signup', _template: 'table' }),
          });
          const data = await res.json();
          if (!res.ok || String(data.success) !== 'true') throw new Error(data.message);
        } catch {
          button.disabled = false;
          button.textContent = 'Join the waitlist';
          showError('Something went wrong. Please try again.');
          return;
        }
      }

      form.hidden = true;
      done.hidden = false;
      note.textContent = '';
    });
  </script>
</Base>
